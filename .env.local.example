NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin: the email of the account that can access /overview
ADMIN_EMAIL=your-main-email@gmail.com

# Supabase service role key (from dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret used to encrypt users' Anthropic API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=your-32-byte-base64-secret

# ── Google OAuth (shared by the Calendar, Sheets, and Docs integrations) ──────
# From Google Cloud Console → APIs & Services → Credentials → "OAuth 2.0 Client
# ID" (Web application). Add GOOGLE_REDIRECT_URI below as an Authorized redirect
# URI on that client. Access + refresh tokens are stored encrypted (AES-256-GCM)
# in the user_google_tokens table — run supabase/google_oauth.sql once first.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://syncedsys.com/api/google/callback

# ── Workspace Photo Library ───────────────────────────────────────────────────
# Bearer token the iOS companion app sends when uploading workspace photos.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COMPANION_APP_SECRET=your-companion-app-secret

# ── Research satellite (i.syncedsys) ──────────────────────────────────────────
# The research_* MCP tools call the i.syncedsys research API over HTTP.
# RESEARCH_API_SECRET must be byte-for-byte identical to MCP_SECRET in the
# syncedsys-i satellite, or every research_* tool fails with a 401.
RESEARCH_API_BASE_URL=https://i.syncedsys.com
RESEARCH_API_SECRET=same-value-as-MCP_SECRET-in-syncedsys-i

# ── Gate (decoy-site access request ingestion) ────────────────────────────────
# Shared secret the decoy site sends in X-Gate-Secret on POST /api/gate/request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATE_SECRET=your-gate-secret
